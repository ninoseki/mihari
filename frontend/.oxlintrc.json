{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
  "env": {
    "browser": true
  },
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "warn",
    "no-debugger": "warn"
  },
  "ignorePatterns": ["dist", "dist-ssr", "coverage"]
}
